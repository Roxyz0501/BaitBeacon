  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../BaitBeacon/ConfigurationStore.cs" Link="ConfigurationStore.cs" />
    <Compile Include="../BaitBeacon/FailureCircuit.cs" Link="FailureCircuit.cs" />
    <Compile Include="../BaitBeacon/SavedLists.cs" Link="SavedLists.cs" />
    <Compile Include="../BaitBeacon/BaitCatalog.cs" Link="BaitCatalog.cs" />
    <Compile Include="../BaitBeacon/Loc.cs" Link="Loc.cs" />
    <Compile Include="../BaitBeacon/Configuration.cs" Link="Configuration.cs" />
    <Compile Include="../BaitBeacon/StandardPluginTabs.cs" Link="StandardPluginTabs.cs" />
    <EmbeddedResource Include="../BaitBeacon/Plugin.cs" LogicalName="BaitBeacon.Plugin.cs" />
    <EmbeddedResource Include="../BaitBeacon/StandardPluginTabs.cs" LogicalName="BaitBeacon.StandardPluginTabs.cs" />
    <EmbeddedResource Include="../BaitBeacon/Data/fish-bait.json" LogicalName="BaitBeacon.Data.fish-bait.json" />
    <Reference Include="Dalamud" HintPath="$(appdata)\XIVLauncher\addon\Hooks\dev\Dalamud.dll" />
